#!/usr/bin/env python3
"""Install SumiNami web apps: Firefox profile, icons, and launcher.

    webapp-install <app> [<app>...]
    webapp-install --all

Idempotent -- rerunning refreshes generated files and leaves browsing data
alone, so it is safe to call from install.sh on every run.

Icons are generated rather than shipped per-state: the brand glyph is composed
with a count badge into one SVG per unread value, so the tray can show a real
number by switching icon names instead of rendering anything at runtime.
"""

from __future__ import annotations

import argparse
import shutil
import subprocess
import sys
import xml.etree.ElementTree as ET
from pathlib import Path
from urllib.parse import urlparse

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

import webapp  # noqa: E402

SVG_NS = "http://www.w3.org/2000/svg"
ICON_DIR = Path.home() / ".local/share/icons/hicolor/scalable/apps"
DESKTOP_DIR = Path.home() / ".local/share/applications"

# Badge colour is fixed rather than themed: the tray sits among application
# icons that keep their brand colours, and an unread marker has to stay legible
# against every SumiNami theme.
BADGE_FILL = "#E46876"
BADGE_TEXT = "#FFFFFF"


def _qname(tag: str) -> str:
    """Namespace-qualified SVG tag.

    Elements are built in the SVG namespace rather than carrying a hand-written
    xmlns attribute: the glyph parsed from the asset is already namespaced, and
    setting xmlns by hand as well makes ElementTree emit it twice, which is a
    fatal XML error for librsvg.
    """
    return f"{{{SVG_NS}}}{tag}"


def log(message: str) -> None:
    print(f"  {message}")


# -- Firefox profile ------------------------------------------------------

USER_JS = """// {name} -- SumiNami web app. Regenerated by webapp-install.
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", {chrome});
user_pref("browser.startup.homepage", "{url}");
user_pref("browser.startup.page", 1);
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.tabs.warnOnClose", false);
user_pref("browser.aboutwelcome.enabled", false);
user_pref("browser.messaging-system.whatsNewPanel.enabled", false);
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("datareporting.policy.firstRunURL", "");
"""

# Some sites gate on a browser allow-list rather than on any capability they
# actually need, and refuse to load in Firefox for no technical reason.
#
# This is the profile-wide override, not the per-domain
# general.useragent.override.<domain> form -- that variant is silently ignored
# by current Firefox, which looks identical to the site simply not accepting
# the spoof. Profile-wide is safe here because a web-app profile only ever
# visits its own site.
USER_AGENT_JS = 'user_pref("general.useragent.override", "{ua}");\n'

# Default page zoom for the profile. Sites that hide their desktop interface in
# a narrow window can be coaxed into showing it by zooming out, which is worth
# having when the alternative is floating the window or handing it a workspace.
ZOOM_JS = ('user_pref("zoom.defaultPercent", {zoom});\n'
           'user_pref("browser.zoom.siteSpecific", false);\n')

# Prefs this installer owns. user.js can only ADD prefs -- dropping a field from
# a definition leaves the old value behind in prefs.js, still in effect and
# looking deliberate. These keys are therefore stripped from prefs.js on every
# install, so user.js is the single source of truth for them.
MANAGED_PREFS = (
    "general.useragent.override",
    "zoom.defaultPercent",
    "browser.zoom.siteSpecific",
    "permissions.default.",
)

# Firefox anchors permission prompts to the navigation toolbar. app_chrome
# collapses that toolbar, so a prompt has nowhere to draw: the page dims waiting
# for an answer that can never be given, and the window is stuck. Deciding the
# permission up front means no prompt is ever raised.
NOTIFY_JS = 'user_pref("permissions.default.desktop-notification", {value});\n'
NOTIFY_VALUES = {"allow": 1, "deny": 2, "ask": 0}

# Every permission a page can request must be decided in advance when the
# navigation toolbar is hidden, because the prompt Firefox would raise has
# nowhere to draw. A site left at "ask" simply dims and hangs forever.
PERMISSION_PREFS = {
    "camera": "permissions.default.camera",
    "microphone": "permissions.default.microphone",
    "notifications": "permissions.default.desktop-notification",
    "geolocation": "permissions.default.geo",
    "screenshare": "permissions.default.screen",
    "xr": "permissions.default.xr",
}
PERMISSION_JS = 'user_pref("{pref}", {value});\n'


def permission_lines(app: webapp.WebApp) -> str:
    """Decide every promptable permission, so none can hang a chromeless window."""
    decided = {}
    if app.notifications in NOTIFY_VALUES:
        decided["notifications"] = app.notifications
    for entry in (app.permissions or "").split(","):
        name, _, value = entry.partition(":")
        name, value = name.strip().lower(), value.strip().lower()
        if name in PERMISSION_PREFS and value in NOTIFY_VALUES:
            decided[name] = value

    # With no toolbar there is no way to answer a prompt, so anything the
    # definition did not decide is denied rather than left to hang.
    if app.app_chrome:
        for name in PERMISSION_PREFS:
            decided.setdefault(name, "deny")

    return "".join(
        PERMISSION_JS.format(pref=PERMISSION_PREFS[n], value=NOTIFY_VALUES[v])
        for n, v in sorted(decided.items()))



USER_CHROME = """/* {name} -- SumiNami web app. Regenerated by webapp-install.
   Hides the tab strip and navigation toolbar so the window reads as an app.
   Set app_chrome = false in the definition to keep normal Firefox chrome. */

#TabsToolbar {{
  visibility: collapse !important;
}}

#nav-bar {{
  visibility: collapse !important;
}}

#navigator-toolbox {{
  border-bottom: 0 !important;
}}
"""


USER_CONTENT = """/* {name} -- SumiNami web app. Regenerated by webapp-install.
   Page CSS for this profile only. Selectors come from hide_selectors in the
   definition; sites that ship generated class names will change them on any
   frontend rebuild, so treat these as disposable. */

@-moz-document domain({domain}) {{
{rules}
}}
"""


def install_user_content(app: webapp.WebApp, profile: Path) -> None:
    chrome_dir = profile / "chrome"
    target = chrome_dir / "userContent.css"
    if not app.hide_selectors:
        if target.exists():
            target.unlink()
        return

    selectors = [s.strip() for s in app.hide_selectors.split(",") if s.strip()]
    if not selectors:
        return
    rules = "\n".join(f"  {sel} {{ display: none !important; }}" for sel in selectors)
    host = urlparse(app.url).hostname or ""
    chrome_dir.mkdir(exist_ok=True)
    target.write_text(
        USER_CONTENT.format(name=app.name, domain=host, rules=rules),
        encoding="utf-8")
    log(f"pagecss  {len(selectors)} selector(s) hidden")


def install_profile(app: webapp.WebApp) -> None:
    profile = app.profile_dir
    profile.mkdir(parents=True, exist_ok=True)
    body = USER_JS.format(
        name=app.name,
        url=app.url,
        chrome="true" if (app.app_chrome or app.hide_selectors) else "false",
    )
    if app.user_agent:
        body += USER_AGENT_JS.format(ua=app.user_agent)
    if app.zoom:
        body += ZOOM_JS.format(zoom=app.zoom)
    body += permission_lines(app)
    (profile / "user.js").write_text(body, encoding="utf-8")

    chrome_dir = profile / "chrome"
    chrome_css = chrome_dir / "userChrome.css"
    if app.app_chrome:
        chrome_dir.mkdir(exist_ok=True)
        chrome_css.write_text(USER_CHROME.format(name=app.name), encoding="utf-8")
    elif chrome_css.exists():
        chrome_css.unlink()

    install_user_content(app, profile)
    _strip_managed_prefs(profile)
    log(f"profile  {profile}")


def _strip_managed_prefs(profile: Path) -> None:
    """Drop installer-owned prefs from prefs.js so user.js fully decides them.

    Skipped while the profile is in use: Firefox rewrites prefs.js on exit and
    would simply restore what we removed.
    """
    prefs = profile / "prefs.js"
    if not prefs.is_file() or (profile / ".parentlock").exists():
        return
    kept, dropped = [], 0
    for line in prefs.read_text(encoding="utf-8", errors="replace").splitlines():
        if any(f'user_pref("{k}"' in line for k in MANAGED_PREFS):
            dropped += 1
            continue
        # The dead per-domain form of the UA override, written by an earlier
        # version. It never had any effect but looks like it should.
        if 'user_pref("general.useragent.override.' in line:
            dropped += 1
            continue
        kept.append(line)
    if dropped:
        prefs.write_text("\n".join(kept) + "\n", encoding="utf-8")
        log(f"prefs    cleared {dropped} stale managed pref(s)")


# -- icons ----------------------------------------------------------------

def _load_glyph(app: webapp.WebApp) -> tuple[ET.Element, str]:
    """Return the brand SVG root and its viewBox, coloured for this app."""
    source = webapp.ASSETS_DIR / f"{app.icon}.svg"
    if not source.is_file():
        raise FileNotFoundError(f"missing icon asset: {source}")

    root = ET.parse(source).getroot()
    root.set("fill", app.color)
    return root, root.get("viewBox", "0 0 24 24")


def _badged_icon(glyph: ET.Element, view_box: str, count: int | None) -> ET.Element:
    """Compose the glyph into a 32x32 canvas, optionally with a count badge.

    The glyph is nested as a child <svg> with its own viewBox, which scales it
    without touching its path data -- no re-parsing of geometry, and the brand
    asset stays the single source of truth.
    """
    root = ET.Element(_qname("svg"), {
        "viewBox": "0 0 32 32",
        "width": "32",
        "height": "32",
    })

    inner = ET.SubElement(root, _qname("svg"), {
        "x": "0", "y": "0",
        "width": "26" if count is not None else "32",
        "height": "26" if count is not None else "32",
        "viewBox": view_box,
    })
    for key, value in glyph.attrib.items():
        if key in ("fill",):
            inner.set(key, value)
    for child in list(glyph):
        inner.append(child)

    if count is None:
        return root

    ET.SubElement(root, _qname("circle"), {
        "cx": "23", "cy": "23", "r": "9", "fill": BADGE_FILL,
    })

    saturated = count > webapp.MAX_BADGE
    label = f"{webapp.MAX_BADGE}+" if saturated else str(count)
    # Baselines are set explicitly: librsvg's dominant-baseline support is
    # patchy, and a mis-centred digit is very visible at tray size.
    ET.SubElement(root, _qname("text"), {
        "x": "23",
        "y": "27.2" if saturated else "27.5",
        "font-family": "sans-serif",
        "font-size": "11" if saturated else "13",
        "font-weight": "bold",
        "text-anchor": "middle",
        "fill": BADGE_TEXT,
    }).text = label

    return root


def install_icons(app: webapp.WebApp) -> None:
    glyph, view_box = _load_glyph(app)
    ICON_DIR.mkdir(parents=True, exist_ok=True)
    ET.register_namespace("", SVG_NS)

    # None is the plain glyph drawn at zero unread -- no badge at all. Then one
    # icon per literal count, plus a final overflow icon for anything larger.
    written = 0
    for count in [None] + list(range(1, webapp.MAX_BADGE + 2)):
        name = app.icon_name if count is None else app.unread_icon_name(count)
        # _badged_icon consumes the glyph's children, so reparse per variant.
        glyph, view_box = _load_glyph(app)
        tree = ET.ElementTree(_badged_icon(glyph, view_box, count))
        tree.write(ICON_DIR / f"{name}.svg", encoding="unicode", xml_declaration=False)
        written += 1

    log(f"icons    {written} variants -> {ICON_DIR}")


# -- launcher -------------------------------------------------------------

DESKTOP = """[Desktop Entry]
Type=Application
Name={name}
Comment={name} web app
Exec={tray} {app}
Icon={icon}
Terminal=false
Categories=Network;
StartupNotify=true
StartupWMClass={wm_class}
"""


def install_desktop(app: webapp.WebApp) -> None:
    DESKTOP_DIR.mkdir(parents=True, exist_ok=True)
    tray = Path(__file__).resolve().parent / "webapp-tray"
    path = DESKTOP_DIR / f"suminami-webapp-{app.app}.desktop"
    path.write_text(
        DESKTOP.format(
            name=app.name,
            tray=tray,
            app=app.app,
            icon=app.icon_name,
            wm_class=app.wm_class,
        ),
        encoding="utf-8",
    )
    log(f"launcher {path.name}")


# -- Hyprland window rules ------------------------------------------------

RULES_HEADER = """# Generated by webapp-install -- do not edit, changes are overwritten.
#
# Web-app windows open straight into their hidden stash workspace, so starting
# one at login does not hijack the screen. Showing an app moves its window onto
# the workspace you are currently on, where it tiles normally.
#
# The stash rule deliberately matches tiled windows only. A file picker or
# other dialog Firefox opens carries the SAME window class as the app, so an
# unrestricted rule hides the dialog in the stash and the app waits forever on
# something the user cannot see or reach.
"""

RULE = """
windowrule {{
    name = webapp-{app}
    match:class = ^({wm_class})$
    match:float = false
    workspace = {stash} silent
}}
"""

# Some sites hide their desktop interface below a window width and offer only a
# "download the app" page instead. Floating at a fixed size keeps such an app
# wide enough regardless of how the workspace is tiled.
SIZE_RULE = """
windowrule {{
    name = webapp-{app}-size
    match:class = ^({wm_class})$
    float = true
    size = {size}
    center = true
}}
"""

BIND = "bind = {key}, exec, {ctl} {app} focus\n"


def install_window_rules() -> None:
    """Regenerate the drop-in describing every installed web app.

    Placing windows via a rule rather than moving them after the fact avoids a
    visible flash of the window before it is stashed.
    """
    rules_dir = webapp.ROOT / "config" / "hypr" / "conf.d"
    if not rules_dir.is_dir():
        return

    body = RULES_HEADER
    for name in webapp.available():
        try:
            app = webapp.load(name)
        except webapp.DefinitionError:
            continue
        if not app.profile_dir.is_dir():
            continue
        body += RULE.format(app=app.app, wm_class=app.wm_class,
                            stash=app.stash_workspace)
        if app.window_size:
            body += SIZE_RULE.format(app=app.app, wm_class=app.wm_class,
                                     size=app.window_size)
        if app.key:
            ctl = Path(__file__).resolve().parent / "webapp-ctl"
            body += BIND.format(key=app.key, ctl=ctl, app=app.app)

    (rules_dir / "50-webapps.conf").write_text(body, encoding="utf-8")

    if shutil.which("hyprctl"):
        subprocess.run(["hyprctl", "reload"], capture_output=True, check=False)


def refresh_caches() -> None:
    if shutil.which("gtk-update-icon-cache"):
        subprocess.run(
            ["gtk-update-icon-cache", "-f", "-t", str(ICON_DIR.parents[1])],
            capture_output=True, check=False,
        )
    if shutil.which("update-desktop-database"):
        subprocess.run(
            ["update-desktop-database", str(DESKTOP_DIR)],
            capture_output=True, check=False,
        )


# -- removal --------------------------------------------------------------

def remove(name: str) -> bool:
    """Delete a web app's profile, icons and launcher.

    The profile holds the login, so removing it means scanning a QR code again
    on reinstall. Nothing else is destroyed -- definitions stay put, so the app
    can be reinstalled from the same file.
    """
    try:
        app = webapp.load(name)
    except webapp.DefinitionError as exc:
        print(f"webapp-install: {exc}", file=sys.stderr)
        return False

    print(f"Removing {app.name} ({app.app})")
    profile = app.profile_dir
    if profile.is_dir():
        shutil.rmtree(profile, ignore_errors=True)
        log(f"profile  removed {profile}")
    else:
        log("profile  not installed")

    gone = 0
    for icon in ICON_DIR.glob(f"{app.icon_name}*.svg"):
        icon.unlink(missing_ok=True)
        gone += 1
    log(f"icons    removed {gone}")

    desktop = DESKTOP_DIR / f"suminami-webapp-{app.app}.desktop"
    if desktop.exists():
        desktop.unlink()
        log(f"launcher removed {desktop.name}")
    return True


# -- entry point ----------------------------------------------------------

def install(name: str) -> bool:
    try:
        app = webapp.load(name)
    except webapp.DefinitionError as exc:
        print(f"webapp-install: {exc}", file=sys.stderr)
        return False

    # Check the asset before writing anything. The profile directory is what
    # autostart treats as "installed", so creating it and then failing would
    # leave the app looking installed while its icons do not exist.
    asset = webapp.ASSETS_DIR / f"{app.icon}.svg"
    if not asset.is_file():
        print(f"webapp-install: {name}: missing icon asset: {asset}",
              file=sys.stderr)
        return False

    print(f"{app.name} ({app.app})")
    try:
        install_profile(app)
        install_icons(app)
        install_desktop(app)
    except (OSError, ET.ParseError, FileNotFoundError) as exc:
        print(f"webapp-install: {name}: {exc}", file=sys.stderr)
        return False
    return True


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Install SumiNami web apps (profile, icons, launcher).")
    parser.add_argument("apps", nargs="*", help="web app names")
    parser.add_argument("--all", action="store_true", help="install every definition")
    parser.add_argument("--installed", action="store_true",
                        help="refresh only web apps that are already installed")
    parser.add_argument("--list", action="store_true", help="list definitions and exit")
    parser.add_argument("--remove", action="store_true",
                        help="remove the named web apps (profile, icons, launcher)")
    args = parser.parse_args()

    if args.list:
        for name in webapp.available():
            print(name)
        return 0

    if args.remove:
        if not args.apps:
            parser.error("name at least one web app to remove")
        ok = all([remove(name) for name in args.apps])
        install_window_rules()
        refresh_caches()
        return 0 if ok else 1

    if args.installed:
        # Refresh path. Deliberately NOT --all: a definition added by a later
        # update must not install itself onto a machine whose owner only ever
        # opted into the apps they already have.
        names = [n for n in webapp.available()
                 if (webapp.profile_root() / n).is_dir()]
    elif args.all:
        names = webapp.available()
    else:
        names = args.apps

    if not names:
        if args.installed:
            return 0
        parser.error("name at least one web app, or pass --all")

    ok = all([install(name) for name in names])
    install_window_rules()
    refresh_caches()
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
