#!/usr/bin/env python3
"""Tray icon for a SumiNami web app.

    webapp-tray <app>

Firefox registers no StatusNotifierItem of its own, so a web-app window can
never appear in Waybar's tray beside Spotify, Nextcloud and Vesktop. This agent
registers one on its behalf.

The SNI spec is implemented directly rather than through libayatana-appindicator,
which always hands left-click to its own menu. Here left-click calls Activate
and the menu is reachable only by right-click, which is what a tray icon is
expected to do -- and matches how Vesktop and Nextcloud behave.

Agent lifetime tracks the app: it launches the window on start and exits once
that window goes away, so quitting from the tray removes the icon rather than
leaving a dead entry behind. Starting it again while one is running just brings
the existing window to the front.

Unread count comes from the window title, matched with the definition's
unread_pattern, and is shown as a real number by switching to a pre-rendered
badge icon. Exits quietly when the app is not installed, so an autostart entry
costs nothing for someone who never installed it.
"""

from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path

import gi

from gi.repository import Gio, GLib  # noqa: E402

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

import webapp  # noqa: E402

CTL = Path(__file__).resolve().parent / "webapp-ctl"
POLL_SECONDS = 3
# Polls that must consecutively report the window absent before the agent
# concludes the app really quit. Guards against a momentary hyprctl hiccup
# tearing down a live tray icon.
MISSING_POLLS_TO_EXIT = 2
SNI_PATH = "/StatusNotifierItem"
MENU_PATH = "/MenuBar"

SNI_XML = """
<node>
  <interface name="org.kde.StatusNotifierItem">
    <property name="Category" type="s" access="read"/>
    <property name="Id" type="s" access="read"/>
    <property name="Title" type="s" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="WindowId" type="i" access="read"/>
    <property name="IconName" type="s" access="read"/>
    <property name="AttentionIconName" type="s" access="read"/>
    <property name="OverlayIconName" type="s" access="read"/>
    <property name="ToolTip" type="(sa(iiay)ss)" access="read"/>
    <property name="ItemIsMenu" type="b" access="read"/>
    <property name="Menu" type="o" access="read"/>
    <method name="Activate">
      <arg name="x" type="i" direction="in"/>
      <arg name="y" type="i" direction="in"/>
    </method>
    <method name="SecondaryActivate">
      <arg name="x" type="i" direction="in"/>
      <arg name="y" type="i" direction="in"/>
    </method>
    <method name="ContextMenu">
      <arg name="x" type="i" direction="in"/>
      <arg name="y" type="i" direction="in"/>
    </method>
    <method name="Scroll">
      <arg name="delta" type="i" direction="in"/>
      <arg name="orientation" type="s" direction="in"/>
    </method>
    <signal name="NewIcon"/>
    <signal name="NewAttentionIcon"/>
    <signal name="NewToolTip"/>
    <signal name="NewTitle"/>
    <signal name="NewStatus">
      <arg name="status" type="s"/>
    </signal>
  </interface>
</node>
"""

MENU_XML = """
<node>
  <interface name="com.canonical.dbusmenu">
    <property name="Version" type="u" access="read"/>
    <property name="Status" type="s" access="read"/>
    <property name="TextDirection" type="s" access="read"/>
    <property name="IconThemePath" type="as" access="read"/>
    <method name="GetLayout">
      <arg name="parentId" type="i" direction="in"/>
      <arg name="recursionDepth" type="i" direction="in"/>
      <arg name="propertyNames" type="as" direction="in"/>
      <arg name="revision" type="u" direction="out"/>
      <arg name="layout" type="(ia{sv}av)" direction="out"/>
    </method>
    <method name="GetGroupProperties">
      <arg name="ids" type="ai" direction="in"/>
      <arg name="propertyNames" type="as" direction="in"/>
      <arg name="properties" type="a(ia{sv})" direction="out"/>
    </method>
    <method name="GetProperty">
      <arg name="id" type="i" direction="in"/>
      <arg name="name" type="s" direction="in"/>
      <arg name="value" type="v" direction="out"/>
    </method>
    <method name="Event">
      <arg name="id" type="i" direction="in"/>
      <arg name="eventId" type="s" direction="in"/>
      <arg name="data" type="v" direction="in"/>
      <arg name="timestamp" type="u" direction="in"/>
    </method>
    <method name="AboutToShow">
      <arg name="id" type="i" direction="in"/>
      <arg name="needUpdate" type="b" direction="out"/>
    </method>
    <signal name="LayoutUpdated">
      <arg name="revision" type="u"/>
      <arg name="parent" type="i"/>
    </signal>
  </interface>
</node>
"""

ITEM_STATUS = 1
ITEM_SHOW = 2
ITEM_HIDE = 3
ITEM_QUIT = 4


class Tray:
    def __init__(self, connection: Gio.DBusConnection, app: webapp.WebApp,
                 loop: GLib.MainLoop, autostart: bool = False):
        self.conn = connection
        self.app = app
        self.loop = loop
        self.autostart = autostart
        # Consecutive polls that found no window. One failed hyprctl call must
        # not be read as "the app quit", or a hiccup kills the tray icon.
        self.missing_polls = 0
        self.unread = 0
        self.status = "Active"
        self.status_label = "Starting…"
        self.menu_revision = 1
        self.unread_re = app.unread_regex()
        # Guards startup: the agent must not exit before the window it just
        # launched has had a chance to appear.
        self.seen_window = False

        sni = Gio.DBusNodeInfo.new_for_xml(SNI_XML).interfaces[0]
        menu = Gio.DBusNodeInfo.new_for_xml(MENU_XML).interfaces[0]
        self.conn.register_object(SNI_PATH, sni, self.on_sni_method,
                                  self.on_sni_property, None)
        self.conn.register_object(MENU_PATH, menu, self.on_menu_method,
                                  self.on_menu_property, None)
        # Re-announce whenever the watcher appears, rather than once here.
        # See register_with_watcher for why a single attempt is not enough.
        self.watch_id = Gio.bus_watch_name(
            Gio.BusType.SESSION, "org.kde.StatusNotifierWatcher",
            Gio.BusNameWatcherFlags.NONE, self.register_with_watcher, None)

        # Only launch when nothing is running -- adopting an existing window
        # must not yank focus away from whatever the user is doing. At login
        # the window starts parked in the stash, so the app is live and
        # counting unread without stealing the screen.
        ok, title = self.query_window()
        if ok and title is None:
            self.ctl("launch" if self.autostart else "show")
        elif title is not None:
            self.seen_window = True

        GLib.timeout_add_seconds(POLL_SECONDS, self.refresh)

    # -- helpers ----------------------------------------------------------

    def ctl(self, action: str) -> None:
        try:
            subprocess.Popen([str(CTL), self.app.app, action],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass

    def query_window(self) -> tuple[bool, str | None]:
        """Ask Hyprland for the web-app window.

        Returns (query_succeeded, title). The two failures have to stay
        distinguishable: "hyprctl did not answer" says nothing about the app,
        while "hyprctl answered and the window is absent" means it has gone.
        Collapsing them lets one timeout tear down a healthy tray icon.
        """
        try:
            out = subprocess.run(
                ["hyprctl", "clients", "-j"],
                capture_output=True, text=True, timeout=5, check=True,
            ).stdout
            clients = json.loads(out)
        except (subprocess.SubprocessError, json.JSONDecodeError, OSError):
            return False, None

        for client in clients:
            if client.get("class") == self.app.wm_class:
                return True, client.get("title") or ""
        return True, None

    def register_with_watcher(self, *_args) -> None:
        """(Re)announce this item to the StatusNotifierWatcher.

        Called every time the watcher appears on the bus, not once at startup.
        Waybar provides the watcher in-process and it is not D-Bus activatable,
        so a single attempt at login loses the race against waybar's own start
        and fails outright -- and every waybar restart (theme switch, Hub
        reload, update) replaces the owner and would otherwise strand the icon
        for the rest of the session.

        Async so a wedged host cannot block the main loop.
        """
        def done(conn, result):
            try:
                conn.call_finish(result)
            except GLib.Error as exc:
                print(f"webapp-tray: register with watcher failed: {exc}",
                      file=sys.stderr)

        self.conn.call(
            "org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher",
            "org.kde.StatusNotifierWatcher", "RegisterStatusNotifierItem",
            GLib.Variant("(s)", (self.conn.get_unique_name(),)),
            None, Gio.DBusCallFlags.NONE, 5000, None, done)

    @property
    def icon_name(self) -> str:
        if self.unread:
            return self.app.unread_icon_name(self.unread)
        return self.app.icon_name

    # -- StatusNotifierItem ----------------------------------------------

    def on_sni_property(self, _conn, _sender, _path, _iface, prop):
        return {
            "Category": GLib.Variant("s", "Communications"),
            "Id": GLib.Variant("s", f"suminami-webapp-{self.app.app}"),
            "Title": GLib.Variant("s", self.app.name),
            "Status": GLib.Variant("s", self.status),
            "WindowId": GLib.Variant("i", 0),
            "IconName": GLib.Variant("s", self.icon_name),
            "AttentionIconName": GLib.Variant("s", self.icon_name),
            "OverlayIconName": GLib.Variant("s", ""),
            "ToolTip": GLib.Variant("(sa(iiay)ss)",
                                    (self.icon_name, [], self.app.name,
                                     self.status_label)),
            # False is what makes hosts send Activate on left-click instead of
            # popping the menu -- the reason for not using AppIndicator.
            "ItemIsMenu": GLib.Variant("b", False),
            "Menu": GLib.Variant("o", MENU_PATH),
        }.get(prop)

    def on_sni_method(self, _conn, _sender, _path, _iface, method, _params, invocation):
        if method in ("Activate", "SecondaryActivate"):
            self.ctl("toggle")
        invocation.return_value(None)

    def emit(self, signal: str, params=None) -> None:
        try:
            self.conn.emit_signal(None, SNI_PATH, "org.kde.StatusNotifierItem",
                                  signal, params)
        except GLib.Error:
            pass

    # -- dbusmenu ---------------------------------------------------------

    def menu_items(self):
        return [
            (ITEM_STATUS, self.status_label, False),
            (ITEM_SHOW, f"Show {self.app.name}", True),
            (ITEM_HIDE, "Hide to tray", True),
            (ITEM_QUIT, f"Quit {self.app.name}", True),
        ]

    @staticmethod
    def item_props(label: str, enabled: bool):
        return {
            "label": GLib.Variant("s", label),
            "enabled": GLib.Variant("b", enabled),
            "visible": GLib.Variant("b", True),
        }

    def on_menu_property(self, _conn, _sender, _path, _iface, prop):
        return {
            "Version": GLib.Variant("u", 3),
            "Status": GLib.Variant("s", "normal"),
            "TextDirection": GLib.Variant("s", "ltr"),
            "IconThemePath": GLib.Variant("as", []),
        }.get(prop)

    def on_menu_method(self, _conn, _sender, _path, _iface, method, params, invocation):
        if method == "GetLayout":
            children = [
                GLib.Variant("(ia{sv}av)", (i, self.item_props(label, enabled), []))
                for i, label, enabled in self.menu_items()
            ]
            # Raw tuple, not a GLib.Variant: only the "av" children are boxed,
            # and pre-boxing the root makes PyGObject try to rebuild it.
            root = (0, {"children-display": GLib.Variant("s", "submenu")}, children)
            invocation.return_value(
                GLib.Variant("(u(ia{sv}av))", (self.menu_revision, root)))

        elif method == "GetGroupProperties":
            wanted = set(params[0])
            out = [(i, self.item_props(label, enabled))
                   for i, label, enabled in self.menu_items()
                   if not wanted or i in wanted]
            invocation.return_value(GLib.Variant("(a(ia{sv}))", (out,)))

        elif method == "GetProperty":
            item_id, name = params[0], params[1]
            props: dict = {}
            for i, label, enabled in self.menu_items():
                if i == item_id:
                    props = self.item_props(label, enabled)
            invocation.return_value(
                GLib.Variant("(v)", (props.get(name, GLib.Variant("s", "")),)))

        elif method == "Event":
            item_id, event_id = params[0], params[1]
            if event_id == "clicked":
                if item_id == ITEM_SHOW:
                    self.ctl("show")
                elif item_id == ITEM_HIDE:
                    self.ctl("hide")
                elif item_id == ITEM_QUIT:
                    # Close the window; the poll below then tears the icon down.
                    self.ctl("quit")
            invocation.return_value(None)

        elif method == "AboutToShow":
            invocation.return_value(GLib.Variant("(b)", (False,)))

        else:
            invocation.return_value(None)

    def menu_changed(self) -> None:
        self.menu_revision += 1
        try:
            self.conn.emit_signal(None, MENU_PATH, "com.canonical.dbusmenu",
                                  "LayoutUpdated",
                                  GLib.Variant("(ui)", (self.menu_revision, 0)))
        except GLib.Error:
            pass

    # -- polling ----------------------------------------------------------

    def parse_unread(self, title: str) -> int:
        if not self.unread_re:
            return 0
        match = self.unread_re.search(title)
        if not match:
            return 0
        try:
            return int(match.group(1))
        except (IndexError, ValueError):
            return 0

    def refresh(self) -> bool:
        ok, title = self.query_window()

        if not ok:
            # Hyprland did not answer. Says nothing about the app; wait.
            return True

        if title is None:
            self.missing_polls += 1
            if self.seen_window and self.missing_polls >= MISSING_POLLS_TO_EXIT:
                # The app is gone -- take the tray icon with it.
                self.loop.quit()
                return False
            return True

        self.missing_polls = 0
        self.seen_window = True
        unread = self.parse_unread(title)

        if unread != self.unread:
            self.unread = unread
            self.status = "NeedsAttention" if unread else "Active"
            self.status_label = (
                f"{unread} unread message{'s' if unread != 1 else ''}"
                if unread else "No unread messages")
            self.emit("NewIcon")
            self.emit("NewToolTip")
            self.emit("NewStatus", GLib.Variant("(s)", (self.status,)))
            self.menu_changed()
        elif self.status_label == "Starting…":
            self.status_label = "No unread messages"
            self.menu_changed()

        return True


def main() -> int:
    args = [a for a in sys.argv[1:] if a != "--autostart"]
    autostart = "--autostart" in sys.argv[1:]

    if len(args) != 1:
        print("usage: webapp-tray [--autostart] <app>", file=sys.stderr)
        return 2

    name = args[0]
    try:
        app = webapp.load(name)
    except webapp.DefinitionError as exc:
        print(f"webapp-tray: {exc}", file=sys.stderr)
        return 1

    # Not installed: stay silent. Autostart entries ship for every definition,
    # and must cost nothing for someone who never installed this app.
    if not app.profile_dir.is_dir():
        return 0

    loop = GLib.MainLoop()

    def on_acquired(connection, _name):
        Tray(connection, app, loop, autostart=autostart)

    def on_lost(_connection, _name):
        # Another agent already owns this icon: treat the launch as "show me
        # the window" rather than starting a duplicate.
        try:
            subprocess.Popen([str(CTL), app.app, "show"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass
        loop.quit()

    Gio.bus_own_name(Gio.BusType.SESSION, f"org.suminami.WebApp.{app.app}",
                     Gio.BusNameOwnerFlags.DO_NOT_QUEUE,
                     None, on_acquired, on_lost)
    loop.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
