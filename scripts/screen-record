#!/bin/bash
# Screen Recording Toggle (wf-recorder)
# Auto-detects GPU for hardware acceleration with CPU fallback

RECORDINGS_DIR="$HOME/Videos"
PIDFILE="/tmp/suminami-recording.pid"

# Ensure Videos directory exists
mkdir -p "$RECORDINGS_DIR"

# Detect best encoder
get_encoder() {
    # Check for NVIDIA GPU with driver loaded
    if lspci | grep -iq nvidia && lsmod | grep -q "^nvidia"; then
        # Verify nvenc is available
        if ffmpeg -encoders 2>/dev/null | grep -q h264_nvenc; then
            echo "h264_nvenc"
            return
        fi
    fi

    # Check for VAAPI (Intel/AMD)
    if [ -e /dev/dri/renderD128 ]; then
        if ffmpeg -encoders 2>/dev/null | grep -q h264_vaapi; then
            echo "h264_vaapi"
            return
        fi
    fi

    # Fallback to CPU
    echo "libx264"
}

# Snap a "X,Y WxH" geometry to a multiple-of-4 grid. Covers common fractional
# scales (1.25 needs 4, 1.5 needs 2, 2.0 any). Width/height clamped to >= 4.
snap_geometry() {
    local raw=$1 x y rest dim w h
    x=${raw%%,*}
    rest=${raw#*,}
    y=${rest%% *}
    dim=${rest#* }
    w=${dim%%x*}
    h=${dim##*x}

    x=$(( x / 4 * 4 ))
    y=$(( y / 4 * 4 ))
    w=$(( (w + 3) / 4 * 4 ))
    h=$(( (h + 3) / 4 * 4 ))
    (( w < 4 )) && w=4
    (( h < 4 )) && h=4
    echo "$x,$y ${w}x${h}"
}

# Stop recording
stop_recording() {
    local stopped=false

    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE")
        if kill -0 "$PID" 2>/dev/null; then
            kill -SIGINT "$PID"
            # Give it a moment to finish writing
            sleep 0.3
            # Force kill if still running
            kill -0 "$PID" 2>/dev/null && kill -SIGKILL "$PID"
            stopped=true
        fi
        rm -f "$PIDFILE"
    fi

    # Fallback: kill any orphaned wf-recorder processes
    if pgrep -x wf-recorder >/dev/null 2>&1; then
        pkill -SIGINT -x wf-recorder
        sleep 0.3
        pkill -SIGKILL -x wf-recorder 2>/dev/null
        stopped=true
    fi

    if [ "$stopped" = true ]; then
        notify-send -t 3000 "Recording Stopped" "Saved to ~/Videos/"
        return 0
    fi
    return 1
}

# Start recording
start_recording() {
    local region="$1"
    local timestamp=$(date +%Y%m%d-%H%M%S)
    local filename="$RECORDINGS_DIR/recording-$timestamp.mp4"
    local encoder=$(get_encoder)

    # Build wf-recorder command as array (avoids eval subshell PID issues)
    local cmd=(wf-recorder)

    # Add encoder
    if [ "$encoder" = "h264_vaapi" ]; then
        cmd+=(-c "$encoder" -d /dev/dri/renderD128)
    else
        cmd+=(-c "$encoder")
    fi

    # Add region selection if requested
    if [ "$region" = "region" ]; then
        local raw
        raw=$(slurp 2>/dev/null)
        if [ -z "$raw" ]; then
            notify-send -t 2000 "Recording" "Cancelled"
            return 1
        fi
        # Snap region to a pixel grid so it stays valid under fractional
        # scaling (e.g. scale 1.25 → logical dims must be multiples of 4 so
        # physical pixels land on integer boundaries). Without this,
        # wf-recorder dies with "Failed to copy frame".
        cmd+=(-g "$(snap_geometry "$raw")")
    fi

    # Output file
    cmd+=(-f "$filename")

    # Start recording - array expansion gives us the actual wf-recorder PID
    "${cmd[@]}" &
    echo $! > "$PIDFILE"

    # Notify with encoder info
    local enc_name="CPU"
    [ "$encoder" = "h264_nvenc" ] && enc_name="NVIDIA GPU"
    [ "$encoder" = "h264_vaapi" ] && enc_name="GPU (VAAPI)"

    if [ "$region" = "region" ]; then
        notify-send -t 2000 "Recording Region" "Using $enc_name encoder"
    else
        notify-send -t 2000 "Recording Screen" "Using $enc_name encoder"
    fi
}

# Main logic — pgrep is authoritative so stale/missing PIDFILE can't desync toggle
if pgrep -x wf-recorder >/dev/null 2>&1 || pgrep -x slurp >/dev/null 2>&1; then
    stop_recording
    # Cancel any pending slurp so a second press during region-select aborts cleanly
    pkill -x slurp 2>/dev/null
else
    case "$1" in
        region) start_recording region ;;
        *)      start_recording ;;
    esac
fi
