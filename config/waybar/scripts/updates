#!/bin/bash
# SumiNami update-available indicator for Waybar.
# Hidden when up-to-date; a breathing accent icon when the local clone is behind
# origin/main. The network fetch is throttled to ~weekly (jittered), timeout-bounded,
# and silent when offline, so it never spams the bar and never blocks for long.
#
# Output: Waybar JSON {text,tooltip,class}; class "none" hides the module.

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
# Theme colors (generated by generate-theme.sh); fall back to kanagawa defaults.
source "$SCRIPT_DIR/colors.sh" 2>/dev/null || {
    COLOR_ACCENT="#D27E99"
    COLOR_FG="#DCD7BA"
    COLOR_MUTED="#727169"
}

REPO="$HOME/.config/suminami"
CONFIG_FILE="$HOME/.config/waybar/suminami.conf"
CACHE_DIR="$HOME/.cache/suminami"
STAMP="$CACHE_DIR/last-update-check"
ICON="󰚰"

hide() { echo '{"text":"","tooltip":"","class":"none"}'; exit 0; }

# --- opt-out toggle: update_check=true (default on) ----------------------------
update_check=true
if [ -f "$CONFIG_FILE" ]; then
    v=$(grep "^update_check=" "$CONFIG_FILE" 2>/dev/null | cut -d'=' -f2 | tr -d ' ')
    [ -n "$v" ] && update_check="$v"
fi
[ "$update_check" = "true" ] || hide

# --- only meaningful for a real clone tracking origin/main --------------------
git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 || hide
git -C "$REPO" remote get-url origin >/dev/null 2>&1 || hide
branch=$(git -C "$REPO" symbolic-ref --quiet --short HEAD 2>/dev/null) || hide
[ "$branch" = "main" ] || hide

mkdir -p "$CACHE_DIR"

# --- throttle: weekly base (604800s) + 0..24h jitter --------------------------
now=$(date +%s)
interval=$(( 604800 + (RANDOM % 86400) ))
last=0
[ -f "$STAMP" ] && last=$(cat "$STAMP" 2>/dev/null || echo 0)
if [ $(( now - last )) -ge "$interval" ]; then
    # Timeout + stall detection; fully silent. Stamp only on success so an
    # offline machine retries next poll instead of going dark for a week.
    if timeout 20 git -C "$REPO" -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 \
            fetch --quiet origin main >/dev/null 2>&1; then
        date +%s > "$STAMP"
    fi
fi

# --- how far behind origin/main? ---------------------------------------------
behind=$(git -C "$REPO" rev-list --count HEAD..origin/main 2>/dev/null || echo 0)
[ "$behind" -gt 0 ] 2>/dev/null || hide

# Sanitize the commit subject for BOTH the JSON string and Pango markup: a literal
# " would terminate the JSON, and & < > would break the Pango tooltip. Escape the
# backslash first so the later &-substitutions aren't doubled.
tip=$(git -C "$REPO" log -1 --format='%s' origin/main 2>/dev/null \
        | sed 's/\\/\\\\/g; s/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g')

tooltip="<span color='$COLOR_ACCENT'><b>SumiNami Update</b></span>"
tooltip="$tooltip\n<span color='$COLOR_MUTED'>Behind by</span> <span color='$COLOR_FG'>$behind commit(s)</span>"
[ -n "$tip" ] && tooltip="$tooltip\n<span color='$COLOR_MUTED'>Latest:</span> <span color='$COLOR_FG'>$tip</span>"
tooltip="$tooltip\n\n<span color='$COLOR_MUTED'>Click to update</span>"

echo "{\"text\": \"$ICON\", \"tooltip\": \"$tooltip\", \"class\": \"available\"}"
