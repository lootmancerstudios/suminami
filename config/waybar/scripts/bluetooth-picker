#!/bin/bash
# Bluetooth device picker using rofi

# Check for custom command override
CONFIG_FILE="$HOME/.config/waybar/suminami.conf"
if [ -f "$CONFIG_FILE" ]; then
    custom_cmd=$(grep "^bluetooth_click_command=" "$CONFIG_FILE" | cut -d'=' -f2-)
    if [ -n "$custom_cmd" ]; then
        exec $custom_cmd
    fi
fi

# Menu entries: labels[] is what rofi shows, actions[] is what the selection
# does, matched by index. A device advertises its own name, so packing the
# action into the displayed line meant a name containing the field separator
# could shift which field the parse recovered and redirect the command to an
# address of the sender's choosing. Keeping them apart also stops raw MAC
# addresses from showing up in the menu.
labels=()
actions=()

add_entry() {
    # Strip newlines so one entry is always exactly one rofi line, keeping the
    # index returned by rofi aligned with actions[].
    labels+=("${1//[$'\n\r']/ }")
    actions+=("$2")
}

# Addresses come from bluetoothctl output; refuse anything that is not a plain
# MAC before handing it to a bluetoothctl subcommand.
valid_mac() {
    [[ "$1" =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]]
}

# Paired devices
while read -r _ mac name; do
    [ -z "$mac" ] && continue
    if bluetoothctl info "$mac" 2>/dev/null | grep -q "Connected: yes"; then
        add_entry "󰂱  $name" "disconnect:$mac"
    else
        add_entry "󰂯  $name" "connect:$mac"
    fi
done < <(bluetoothctl devices Paired 2>/dev/null)

# Discovered but unpaired devices
paired_macs=$(bluetoothctl devices Paired 2>/dev/null | awk '{print $2}')
while read -r _ mac name; do
    [ -z "$mac" ] && continue
    grep -qxF "$mac" <<< "$paired_macs" && continue
    add_entry "󰂲  $name  (new)" "pair:$mac"
done < <(bluetoothctl devices 2>/dev/null)

# Trailing options
[ ${#labels[@]} -gt 0 ] && add_entry "─────────────────────────" "separator"
add_entry "󰑓  Scan for devices" "scan"
add_entry "󰜉  Toggle Bluetooth" "toggle"

# -format i returns the index of the selected line rather than its text, so the
# dispatch never has to parse a device-supplied string.
idx=$(printf '%s\n' "${labels[@]}" | rofi -dmenu -cycle -p "Bluetooth" -format i)

# Empty when cancelled; -1 when typed text matched no entry.
[ -z "$idx" ] && exit 0
[[ "$idx" =~ ^[0-9]+$ ]] || exit 0
[ "$idx" -lt "${#actions[@]}" ] || exit 0

action="${actions[$idx]}"
mac="${action#*:}"

case "$action" in
    connect:*)
        valid_mac "$mac" || exit 1
        notify-send "Bluetooth" "Connecting..." -t 2000
        bluetoothctl connect "$mac" && notify-send "Bluetooth" "Connected" -t 2000 || notify-send "Bluetooth" "Connection failed" -t 2000
        ;;
    disconnect:*)
        valid_mac "$mac" || exit 1
        bluetoothctl disconnect "$mac" && notify-send "Bluetooth" "Disconnected" -t 2000
        ;;
    pair:*)
        valid_mac "$mac" || exit 1
        notify-send "Bluetooth" "Pairing..." -t 2000
        if bluetoothctl pair "$mac"; then
            bluetoothctl trust "$mac"
            notify-send "Bluetooth" "Paired successfully. Connecting..." -t 2000
            bluetoothctl connect "$mac"
        else
            notify-send "Bluetooth" "Pairing failed" -t 2000
        fi
        ;;
    scan)
        notify-send "Bluetooth" "Scanning for 8 seconds..." -t 2000
        # Run scan with timeout
        bluetoothctl --timeout 8 scan on &>/dev/null
        notify-send "Bluetooth" "Scan complete" -t 2000
        # Re-open picker
        exec "$0"
        ;;
    toggle)
        powered=$(bluetoothctl show | grep "Powered:" | awk '{print $2}')
        if [ "$powered" = "yes" ]; then
            bluetoothctl power off && notify-send "Bluetooth" "Powered off" -t 2000
        else
            bluetoothctl power on && notify-send "Bluetooth" "Powered on" -t 2000
        fi
        ;;
    separator)
        exit 0
        ;;
esac
